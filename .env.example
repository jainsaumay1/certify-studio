# ══════════════════════════════════════════════════════════
# Certify Studio — Environment Variables Template
# ══════════════════════════════════════════════════════════
# Copy this file to .env.local to configure your environment:
# cp .env.example .env.local

# Optional: Supabase cloud persistence (leave empty for local browser storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Default SMTP settings for certificate dispatch
# (Can also be configured directly via the UI in Step 6 / Step 8)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
